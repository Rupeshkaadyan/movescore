# ---------------------------------------------------------------------------
# MoveScore environment template
# Copy to .env.local for development. Never commit real keys.
# ---------------------------------------------------------------------------

# Public site URL — used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://movescore.app

# ---------------------------------------------------------------------------
# Supabase (Phase 3-5). Optional in Phase 1-2: the app runs on demo data
# without these values.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by ingestion jobs and the admin dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Data ingestion (Phase 4). Keys for the upstream sources listed on
# /methodology.
# ---------------------------------------------------------------------------
CENSUS_API_KEY=
BLS_API_KEY=
HUD_API_KEY=
NOAA_API_KEY=
EPA_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Analytics endpoint (self-hosted or privacy-friendly provider).
NEXT_PUBLIC_ANALYTICS_URL=
# Cron secret protecting /api/ingest.
INGEST_CRON_SECRET=
